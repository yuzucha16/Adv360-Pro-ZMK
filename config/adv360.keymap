#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define KQ  8

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQ           AT                // "
#define JP_AMP          CARET             // &
#define JP_Q            AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define CARET           EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TI           PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQ        LEFT_BRACE        // `
#define USCORE          LS(0x87)          // _
#define LBRT            RIGHT_BRACKET     // [
#define RBRT            BACKSLASH         // ]
#define JP_LP           ASTERISK          // (
#define JP_RP           LEFT_PARENTHESIS  // )
#define JP_LB           RIGHT_BRACE       // {
#define JP_RB           PIPE              // }
#define KANA            LANGUAGE_1        // かな
#define EISU            LANGUAGE_2        // 英数
#define HANZE           GRAVE             // 半角/全角

#define SF              LSHIFT
#define ETR             ENTER
#define UNDO            RC(Z)
#define REDO            RC(Y)
#define BS              BACKSPACE
#define DEL             DELETE
#define CT              RCTRL
#define SCR             LG(LS(S))
#define CAD             RC(RA(DEL))
#define SP              SPACE
#define SCLN            SEMICOLON

#define SC_L            SCRL_LEFT
#define SC_R            SCRL_RIGHT
#define SC_U            SCRL_UP
#define SC_D            SCRL_DOWN

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>; //誤爆が多いなら require-prior-idle-ms を 150、修飾キーが出にくいなら 100 に下げる
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
        //    label = "HOMEROW_MODS";
        //    tapping-term-ms = <150>;
        //    quick-tap-ms = <100>;
        //    flavor = "hold-preferred";

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp HANZE	&kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &tog 1                                                  &mo 3   &kp F6     &kp F7    &kp F8     &kp F9    &kp F10     &kp MINUS
&kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &none                                                   &none   &kp Y      &kp U     &kp I      &kp O     &kp P       &kp JP_AT
&mt CT ESC &kp A    &kp S     &lt 8 D   &kp F     &kp G     &none      &kp RALT   &kp SCR        &trans    &kp LWIN &none   &kp H      &kp J     &kp K      &kp L     &kp SCLN    &kp JP_COLON
&kp SF    &kp Z     &kp X     &kp C     &kp V     &kp B                           &kp HOME       &kp PG_UP                  &kp N      &kp M     &kp COMMA  &kp DOT   &kp SLASH   &kp JP_YEN
&kp CAD   &kp RWIN  &kp EISU  &kp ETR   &kp BS              &lt 1 SP   &lt 2 DEL  &kp END        &kp PG_DN &kp ETR  &kp BS             &kp TAB   &trans     &trans    &kp LALT    &kp USCORE
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans    &kp F11   &kp F12   &trans    &trans    &trans    &trans                                                  &mo 3   &trans     &trans    &trans     &trans    &trans      &trans
&trans    &kp EXCL  &kp JP_DQ &kp HASH  &kp DLLR  &kp PRCNT &none                                                   &none   &kp AMPS   &kp JP_Q  &kp JP_LP  &kp JP_RP &trans      &trans
&trans   	&kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &none      &trans     &trans         &trans    &trans   &none   &trans     &kp CARET &kp LBRT   &kp RBRT  &trans      &trans
&trans    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0                          &trans         &trans                     &trans		 &kp JP_TI &kp JP_LB  &kp JP_RB &trans      &trans
&mo 2     &kp UNDO  &kp REDO  &trans	  &trans              &trans     &trans     &trans         &trans  	 &trans  	&trans             &trans    &trans     &trans	  &trans      &mo 2
            >;
        };
        
        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
        
        Kq {
            display-name = "Kq";
            bindings = <
&trans    &trans    &trans    &trans    &trans    &trans    &trans                                                  &mo 3   &trans     &trans    &trans     &trans    &trans      &trans
&trans    &trans    &trans    &msc SC_U &trans    &trans    &none                                                   &none   &trans     &trans    &trans     &trans    &trans      &trans
&trans   	&trans    &msc SC_L &msc SC_D &msc SC_R &trans    &none      &trans     &trans         &trans    &trans   &none   &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT &trans      &trans
&trans    &trans    &mkp RCLK &mkp MCLK &mkp LCLK &trans                          &trans         &trans                     &trans     &trans    &trans     &trans    &trans      &trans
&mo 2     &trans    &trans    &trans    &trans              &kp SP     &kp DEL    &trans         &trans  	 &trans  	&trans             &trans    &trans     &trans	  &trans      &mo 2
            >;
        };
    };
};
